{
    "compilerOptions": {
        "outDir": "./dist/",
        "noImplicitAny": true,
        "module": "commonjs",
        "target": "es6",
        "allowJs": true,
        "baseUrl": ".",
        "downlevelIteration": true,
        "skipLibCheck": true,
        "paths": {
            "@App/*": [
                "src/*"
            ],
            "@Test/*": [
                "tests/*"
            ],
            "@/lib/*": [
                "src/lib/*"
            ],
            "@/components/*": [
                "src/components/*"
            ]
        }
    },
    "include": [
        "./src/*.ts",
        "./src/**/*.ts",
        "./tests/*.test.ts"
    ]
}
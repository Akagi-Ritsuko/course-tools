{
  "manifest_version": 3,
  "name": "网课小工具",
  "version": "2.5.2",
  "description": "一个简单的学习小工具",
  "icons": {
    "16": "img/logo.png",
    "48": "img/logo.png",
    "128": "img/logo.png"
  },
  "action": {
    "default_icon": "img/logo.png",
    "default_title": "网课小工具",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://zsgl.lzlj.com/*",
        "*://lzlj.b.sanjieke.cn/*"
      ],
      "js": [
        "src/start.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://zsgl.lzlj.com/*",
    "*://lzlj.b.sanjieke.cn/*",
    "https://cx.icodef.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/mooc.js"],
      "matches": ["*://zsgl.lzlj.com/*", "*://lzlj.b.sanjieke.cn/*"]
    }
  ],
  "homepage_url": "https://zsgl.lzlj.com/"
}

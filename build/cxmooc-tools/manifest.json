{
  "manifest_version": 2,
  "name": "网课小工具",
  "version": "2.5.2",
  "description": "一个简单的学习小工具",
  "icons": {
    "16": "img/logo.png",
    "48": "img/logo.png",
    "128": "img/logo.png"
  },
  "browser_action": {
    "default_icon": "img/logo.png",
    "default_title": "网课小工具",
    "default_popup": "src/popup.html"
  },
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://zsgl.lzlj.com/*"
      ],
      "js": [
        "src/start.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    "src/mooc.js"
  ],
  "homepage_url": "https://cx.icodef.com",
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'"
}